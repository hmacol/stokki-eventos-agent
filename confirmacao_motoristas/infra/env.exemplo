# Copiar para infra/.env e preencher TOKEN_SECRET/SYNC_SECRET com os
# MESMOS valores gravados em config.yaml na maquina local (secao
# confirmacao_rotas: token_secret / sync_secret). Se nao forem
# identicos aos dois lados, os links de confirmacao e a sincronizacao
# local<->VPS nao funcionam.
TOKEN_SECRET=
SYNC_SECRET=
DB_PATH=/opt/confirmacao-motoristas/confirmacoes.db
PORT=8090
