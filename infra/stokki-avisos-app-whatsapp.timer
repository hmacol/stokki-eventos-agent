[Unit]
Description=Dispara stokki-avisos-app-whatsapp.service a cada 5 minutos (so habilitar depois do OK do Hugo nos textos; a trava avisos_app_motoristas na configuracao da VPS decide se sai, pra quem e se e piloto)

[Timer]
OnCalendar=*:0/5
Persistent=false
AccuracySec=30s

[Install]
WantedBy=timers.target
