[Unit]
Description=Stokki Eventos - Resumo diario do Gmail no WhatsApp do Hugo (le o e-mail "Resumo do e-mail" da rotina na nuvem e encaminha)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/resumo_email_whatsapp.py
