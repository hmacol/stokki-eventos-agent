[Unit]
Description=Stokki Eventos - Acompanhar retiradas no galpao (Stokki Enviado/Cancelado -> VUUPT)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/retiradas/acompanhar_retiradas.py
