[Unit]
Description=Stokki Eventos - Compara o pool Vuupt x nucleo (sombra da Entrega 1) e Vuupt x freshhub (sombra do plano 1.2) e avisa por e-mail se divergir
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
# Saida 2 = achou divergencia PROPRIA do espelho (nao e falha do job; o e-mail
# ja conta a historia). Duplicado na Vuupt nao conta: so aparece no relatorio.
SuccessExitStatus=2
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/nucleo/comparar_pool.py --salvar --email
# Sombra do plano 1.2 (sistema novo): Vuupt x GET /api/pool do freshhub. Sem freshhub_api no config.yaml,
# so avisa no log e sai 0 (sombra desligada); portao = 3 dias uteis em 0 na fonte freshhub.
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/nucleo/comparar_pool.py --salvar --email --fonte freshhub
