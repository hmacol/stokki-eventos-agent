[Unit]
Description=Stokki Eventos - E-mail diario por embarcador com o status de todas as notas do dia (entregues, falhas, em aberto)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/resumo_diario_embarcador.py --data hoje
