[Unit]
Description=Stokki Eventos - Publica no marketplace as rotas com horario agendado no /planejamento
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos/painel_agentes
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/painel_agentes/publicar_ofertas_agendadas.py
