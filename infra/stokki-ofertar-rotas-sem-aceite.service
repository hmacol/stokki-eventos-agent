[Unit]
Description=Stokki Eventos - Oferta de rota sem aceite (rota recusada ou sem aceite ate 05h30 vai pros outros motoristas no app)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/nucleo/ofertas_rota_enviada.py
