[Unit]
Description=Stokki Eventos - Coleta noturna do XML da NF-e na Stokki pro freshhub (so leitura, conta provider)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/documentos_pedido/coletar_xml_nfe.py
# o script para sozinho as 03:40 (antes de romaneios 04:00 e notificar-transportadoras 04:10);
# isto e o teto se uma pagina travar
RuntimeMaxSec=4h20min
