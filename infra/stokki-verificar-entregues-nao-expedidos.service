[Unit]
Description=Stokki Eventos - Checagem diaria de entregues sem expedicao na Stokki (verificar_entregues_nao_expedidos.py)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/verificar_entregues_nao_expedidos.py
