[Unit]
Description=Stokki Eventos - Lembrete diario ao embarcador sobre transportadora desconhecida e alerta a equipe
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/lembrar_consultas_transportadora.py
