[Unit]
Description=Stokki Eventos - Retornos nao recebidos ate 07h (insucesso/parcial sem descarga confirmada -> grupo Alertas do /atendimento)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/alertar_retornos_atrasados.py
