[Unit]
Description=Stokki Eventos - Sincroniza respostas de confirmacao de rota dos motoristas
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos/roteirizacao
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/roteirizacao/sincronizar_respostas_confirmacao.py
