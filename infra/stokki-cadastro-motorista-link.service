[Unit]
Description=Stokki Eventos - Cadastro de motorista pelo link: agente e veiculo na Vuupt, linha na tabela e avisos (retentativa)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/nucleo/cadastro_motorista_link.py --retentar
