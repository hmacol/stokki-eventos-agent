[Unit]
Description=Stokki Eventos - ciencia do dedicado fora do dia fixo: primeiro aviso e lembretes ao embarcador (chat, e-mail, WhatsApp)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/notificar_ciencia_dedicado.py
