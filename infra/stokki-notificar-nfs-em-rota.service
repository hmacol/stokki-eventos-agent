[Unit]
Description=Stokki Eventos - E-mail diario por embarcador com as notas que saem pra entrega hoje
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/notificar_nfs_em_rota.py --data hoje
