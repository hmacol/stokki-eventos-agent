[Unit]
Description=Stokki Eventos - Batimento de pedidos (destino final de cada PS desde o corte; so le Stokki/Vuupt, grava batimento_*)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python -m batimento.bater
