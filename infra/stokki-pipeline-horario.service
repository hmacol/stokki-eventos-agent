[Unit]
Description=Stokki Eventos - Importacao Stokki -> Vuupt de hora em hora (pipeline.py --horario; desiste se a sessao da Stokki estiver em uso)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/pipeline.py --horario
