[Unit]
Description=Stokki Eventos - Cross: Aberto -> Aguardando Transportador (conferir_cross_diario.py)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/stokki/conferir_cross_diario.py --confirmar
