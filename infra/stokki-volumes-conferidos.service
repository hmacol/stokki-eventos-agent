[Unit]
Description=Stokki Eventos - Volumes conferidos dos pedidos das rotas do dia (atualizar_volumes_conferidos.py --data hoje)
OnFailure=stokki-alerta-falha@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/stokki-eventos/roteirizacao
# teto de 15 min: o romaneio das 04h espera esta rotina terminar (After= la)
TimeoutStartSec=900
ExecStart=/opt/stokki-eventos/venv/bin/python /opt/stokki-eventos/roteirizacao/atualizar_volumes_conferidos.py --data hoje
