[Unit]
Description=Homologacao do legado - painel (homolog.freshhub.com.br/painel, porta 8171)
After=network.target homolog-nft.service
# sem a regra de firewall do usuario homolog o servico nao sobe (falha fechada)
Requires=homolog-nft.service

[Service]
Type=simple
User=homolog
Group=homolog
UMask=0027
WorkingDirectory=/opt/stokki-homolog/painel_agentes
Environment=FRESH_AMBIENTE=homolog
Environment=PYTHONPATH=/opt/stokki-homolog/homologacao/site
Environment=PYTHONIOENCODING=utf-8
# trava que nao depende do codigo do ramo: sem a guarda (SMTP falso) o servico nao sobe
ExecStartPre=/opt/stokki-homolog/venv/bin/python -c "import smtplib, socket, sys; sys.exit(0 if smtplib.SMTP.__name__ == 'SMTPFalso' else 1)"
ExecStart=/opt/stokki-homolog/venv/bin/waitress-serve --host=127.0.0.1 --port=8171 painel_agentes:app
Restart=on-failure
RestartSec=5
MemoryMax=600M

[Install]
WantedBy=multi-user.target
