# Copiar para .env na VPS (mesma pasta do docker-compose.yml) e preencher.
# O script instalar_vps.sh gera automaticamente as senhas/chaves.
# NUNCA commitar o .env preenchido.

# --- Autenticacao da API (vai tambem em config.yaml -> evolution_api.api_key) ---
AUTHENTICATION_API_KEY=GERAR_COM_openssl_rand_-hex_32

# --- Banco de dados (Postgres do proprio compose) ---
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:GERAR_SENHA_FORTE@postgres:5432/evolution
POSTGRES_PASSWORD=GERAR_SENHA_FORTE
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true

# --- Cache (Redis do proprio compose) ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:GERAR_SENHA_FORTE@redis:6379/6
REDIS_PASSWORD=GERAR_SENHA_FORTE
CACHE_LOCAL_ENABLED=false

# --- Webhook (Evolution -> atendimento/app.py, ver config.yaml -> evolution_api.webhook_secret) ---
# O segredo vai no PATH da URL, nunca em header -- o Caddy da VPS descarta
# silenciosamente headers com "_" no nome (bug conhecido, caddyserver/caddy#6271).
WEBHOOK_GLOBAL_URL=https://atendimento.freshhub.com.br/webhook/evolution/GERAR_SEGREDO_ALEATORIO
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true

LANGUAGE=pt-BR
