# Copiar para .env na VPS (mesma pasta do docker-compose.yml) e preencher.
# O script instalar_vps.sh gera automaticamente SECRET_KEY_BASE e as senhas.
# NUNCA commitar o .env preenchido.

# --- Aplicacao ---
SECRET_KEY_BASE=GERAR_COM_openssl_rand_-hex_64
FRONTEND_URL=https://atendimento.freshhub.com.br
DEFAULT_LOCALE=pt_BR
FORCE_SSL=false
# Deixar true so ate criar a conta da FreshLog e os usuarios; depois trocar para false
# e rodar: docker compose up -d (bloqueia cadastros de estranhos na tela de login)
ENABLE_ACCOUNT_SIGNUP=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local

# --- Banco de dados (Postgres do proprio compose) ---
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=GERAR_SENHA_FORTE
RAILS_MAX_THREADS=5

# --- Redis (do proprio compose) ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=GERAR_SENHA_FORTE

# --- E-mail transacional (convites de usuario, reset de senha, notificacoes) ---
# Conta usada so pro SMTP tecnico (nao e a caixa de entrada do suporte -- essa
# e configurada a parte no canal de E-mail do Chatwoot, item 9 do FASE0.md).
# Google Workspace: gerar senha de app em https://myaccount.google.com/apppasswords
# (exige verificacao em 2 etapas ativa na conta hugo@freshlogbr.com)
MAILER_SENDER_EMAIL=Atendimento FreshLog <hugo@freshlogbr.com>
SMTP_DOMAIN=freshlogbr.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hugo@freshlogbr.com
SMTP_PASSWORD=SENHA_DE_APP_DO_GOOGLE
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
