# Copiar para infra/.env e preencher TOKEN_SECRET/SYNC_SECRET com os
# MESMOS valores gravados em config.yaml na maquina local (secao
# resposta_insucesso: token_secret / sync_secret). Se nao forem
# identicos aos dois lados, os links de resposta e a sincronizacao
# local<->VPS nao funcionam.
TOKEN_SECRET=
SYNC_SECRET=
DB_PATH=/opt/insucesso-resposta/respostas.db
PORT=8091
